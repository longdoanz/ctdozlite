# cp .env.example .env && chmod 600 .env, rồi điền giá trị (KHÔNG commit file .env)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
CTDOZ_HOST_LABEL=my-server
# Bearer token cho REST API 127.0.0.1:17890:  openssl rand -hex 24
CTDOZLITE_API_TOKEN=
# Gửi kèm header X-Ctdozlite-Secret tới webhook:  openssl rand -hex 24
CTDOZLITE_WEBHOOK_SECRET=
# KHÔNG ghi mật khẩu vault vào đây: mật khẩu nằm cùng đĩa sẽ vô hiệu hoá việc mã hoá. Dùng ./unlock.sh.
# Token Bearer cho MCP qua Tailscale, ≥32 ký tự:  openssl rand -hex 32
CTDOZ_MCP_TOKEN=
# Token hooks của OpenClaw (máy chạy OpenClaw: ~/.openclaw/hooks.token) để đánh thức agent
OPENCLAW_HOOK_TOKEN=
# Đặt tự động bởi setup-tailnet.sh: IP Tailscale của server này và của máy chạy OpenClaw
CTDOZ_MCP_BIND=
CTDOZ_MCP_ALLOW_IPS=
